# ---- Hestia configuration ----
# Copy to .env and fill in. NEVER commit .env.

# Shared team login credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign session cookies
APP_SECRET=generate-a-long-random-string

# Server timezone (used for the time/location injected into the system prompt)
TZ=UTC

# Host port exposed by docker compose (the port you open in your browser;
# serves both the UI and the API from a single container)
WEB_PORT=8080

# Optional: pre-provision search/embedding endpoints. These act exactly as if
# the user had entered them in Settings — they do NOT disable the DuckDuckGo
# or local-fastembed fallbacks, which still kick in when the URL is empty or
# the endpoint is unreachable.
SEARXNG_URL=
EMBEDDING_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
