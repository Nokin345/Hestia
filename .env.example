# ---- Hestia configuration ----
# Copy to .env and fill in. NEVER commit .env.

# Shared team login credentials
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me

# Secret used to sign session cookies
APP_SECRET=generate-a-long-random-string

# Server timezone (used for the time/location injected into the system prompt)
TZ=UTC

# Host port exposed by docker compose (the port you open in your browser;
# serves both the UI and the API from a single container)
WEB_PORT=8080

# ---- Optional integrations ----
# These act exactly as if the user had entered them in Settings — they are
# fallbacks only. Values saved in the Settings UI take precedence over .env.

# Web search (SearXNG instance). Leave empty to use the DuckDuckGo fallback.
SEARXNG_URL=

# Remote OCR for scanned documents/PDFs (OpenAI-compatible vision endpoint,
# e.g. llama.cpp, vLLM, Ollama). Leave empty to use local RapidOCR on CPU.
OCR_URL=
OCR_MODEL=
OCR_API_KEY=

# Remote reranker for memory ranking (Jina/Cohere-style /rerank API).
# Leave empty to rank memory candidates by fused relevance score only.
RERANKER_URL=
RERANKER_MODEL=
RERANKER_API_KEY=
